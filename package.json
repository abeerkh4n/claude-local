{
  "name": "claude-cli-evals",
  "version": "0.1.0",
  "private": true,
  "description": "Run LLM calls for evals and tests through your signed-in Claude Code CLI (your Claude subscription) instead of an API key.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "claude-cli-evals": "./dist/doctor.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "CLAUDE_CLI_LIVE=1 vitest run examples",
    "doctor": "tsx src/doctor.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
