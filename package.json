{
  "name": "claude-local",
  "version": "0.2.0",
  "private": true,
  "description": "Use your Claude subscription from Node.js on your own machine, through the signed-in Claude Code CLI: ask, stream, JSON, files, chat.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./evals": {
      "types": "./dist/evals/index.d.ts",
      "default": "./dist/evals/index.js"
    }
  },
  "bin": {
    "claude-local": "./dist/doctor.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "CLAUDE_CLI_LIVE=1 vitest run examples",
    "doctor": "tsx src/doctor.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
